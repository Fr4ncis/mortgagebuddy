{
  "manifest_version": 3,
  "name": "MortgageBuddy for Amazon",
  "version": "1.0.0",
  "description": "Shows what your Amazon basket would take off your mortgage if you overpaid instead of buying it.",
  "permissions": ["storage"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "MortgageBuddy",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.co.uk/gp/cart/*",
        "https://www.amazon.co.uk/cart/*",
        "https://www.amazon.co.uk/gp/aw/c/*",
        "https://www.amazon.com/gp/cart/*",
        "https://www.amazon.com/cart/*",
        "https://www.amazon.com/gp/aw/c/*"
      ],
      "js": ["lib/mortgage.js", "lib/amazon.js", "lib/settings.js", "content/cart.js"],
      "run_at": "document_idle"
    }
  ]
}
